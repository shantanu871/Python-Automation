{%- for vrf in my_vrfs %}
vrf def {{ vrf.vrf_name }}
 !
 {%- if vrf.ipv4_af %}
 address-family ipv4
  route-target export {{ vrf.rd_number }}
  route-target import {{ vrf.rd_number }}
 {%- endif %}
 {%- if vrf.ipv6_af %}
 !
  address-family ipv6
   route-target export {{ vrf.rd_number }}
   route-target import {{ vrf.rd_number }}
  exit-address-family
 {%- endif %}
{%- endfor %}

